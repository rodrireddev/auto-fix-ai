{
  "name": "auto-fixer-ai",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build:web": "esbuild web/src/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=public/build/app.js",
    "watch:web": "esbuild web/src/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/build/app.js --watch=forever",
    "build": "npm run build:web && nest build",
    "start": "npm run build:web && nest start",
    "start:dev": "npm run build:web && concurrently -k -n api,web -c blue,magenta \"nest start --watch\" \"npm:watch:web\"",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "author": "",
  "license": "ISC",
  "description": "Recibe logs de apps, detecta anomalías con un LLM y dispara una routine de Claude Code para arreglarlas",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.7",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "lit": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "private": true
}
