PORT=3000

# Key para entrar al dashboard (http://localhost:3000) y usar /api/*
ADMIN_API_KEY=cambia-esto-por-algo-largo

# Carpeta donde se guarda la base SQLite (auto-fixer.db)
DATA_DIR=./data

# Clave maestra para cifrar las credenciales guardadas en SQLite (API keys de IA,
# tokens de routines, keys de ingesta). Si no la definís se genera DATA_DIR/secret.key.
# Si la perdés o la cambiás, las credenciales guardadas ya no se pueden leer.
SECRETS_KEY=

# ---- LLM ----
# Los proveedores (Groq, OpenRouter, Gemini...) se gestionan desde el dashboard.
# Si LLM_API_KEY está definida, en el PRIMER arranque se importa como proveedor inicial.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=60000
# Máximo de caracteres de logs por llamada (se priorizan las líneas más recientes)
LLM_MAX_LOG_CHARS=24000

# ---- Batching ----
# Cada cuántos ms se analiza el buffer de cada app
FLUSH_INTERVAL_MS=30000
# Analizar de inmediato si el buffer llega a este número de líneas
FLUSH_MAX_LINES=500
# Tope duro del buffer por app (las más viejas se descartan)
BUFFER_HARD_LIMIT=5000

# ---- Disparo de routines ----
# Severidad mínima por defecto: low | medium | high | critical (cada app puede pisarla)
MIN_SEVERITY_TO_FIX=high
# No volver a disparar la routine para la misma anomalía durante este tiempo
FIX_COOLDOWN_MS=3600000
# true = detecta y registra, pero no dispara la routine
DRY_RUN=false

# Opcional: importar apps de un JSON en el primer arranque (ver apps.config.example.json)
APPS_CONFIG_PATH=./apps.config.json
